#!/usr/bin/env bash
# halcyon brew bundle installer — online catch-up fallback at first login.
#
# Design:
#  - halcyon-brew-bundle.service (system, multi-user.target) seeds all
#    Brewfile formulas from the image payload at boot, pre-login and
#    offline — the normal path. This script therefore usually finds
#    everything present and exits in seconds WITHOUT invoking brew.
#  - Only when formulas are genuinely missing (payload seeding failed or
#    was skipped) does it run `brew bundle` online, retried up to 3 times
#    with linear back-off for transient network failures at session start.
set -euo pipefail

readonly BREW="/home/linuxbrew/.linuxbrew/bin/brew"
readonly BREWFILE="/usr/share/ublue-os/homebrew/Brewfile"

echo "=== Halcyon: brew-bundle login-time catch-up ==="

# --- Sanity: Brewfile must be present (shipped in the image) ---
if [[ ! -f "${BREWFILE}" ]]; then
  echo "ERROR: ${BREWFILE} not found in the image — cannot install packages." >&2
  exit 1
fi

# --- Fast path: boot-time seeding usually has everything in place.
#     Check Cellar directories directly — no brew invocation, no network,
#     finishes in under a second. ---
missing=()
while IFS= read -r name; do
  [[ -z "${name}" ]] && continue
  if [[ ! -d "/home/linuxbrew/.linuxbrew/Cellar/${name}" ]]; then
    missing+=("${name}")
  fi
done < <(sed -n 's/^[[:space:]]*brew "\([^"]*\)".*/\1/p' "${BREWFILE}")

if [[ ${#missing[@]} -eq 0 ]]; then
  echo "OK: All Brewfile formulas already present (boot-time seeding) — nothing to do."
  exit 0
fi

echo "INFO: ${#missing[@]} formula(s) missing despite boot seeding: ${missing[*]}"

# --- Wait for brew binary (brew-setup.service runs before user sessions, but
#     on an extremely slow first boot it may still be extracting the tarball) ---
if [[ ! -x "${BREW}" ]]; then
  echo "INFO: Homebrew binary not yet present; waiting for brew-setup.service to finish (up to 60s)..."
  waited=0
  while [[ ! -x "${BREW}" && ${waited} -lt 60 ]]; do
    sleep 2
    waited=$((waited + 2))
  done
fi

if [[ ! -x "${BREW}" ]]; then
  echo "ERROR: ${BREW} not found or not executable after 60s — brew-setup.service may have failed." >&2
  echo "       Run:  systemctl status brew-setup.service" >&2
  exit 1
fi

# --- Suppress brew telemetry and noise ---
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_ENV_HINTS=1

# --- Run brew bundle with linear-backoff retries for transient network issues ---
readonly MAX_ATTEMPTS=3
readonly RETRY_DELAY=15  # seconds between retries

for attempt in $(seq 1 "${MAX_ATTEMPTS}"); do
  echo "INFO: brew bundle --no-lock --file=${BREWFILE}  (attempt ${attempt}/${MAX_ATTEMPTS})"
  if "${BREW}" bundle --no-lock --file="${BREWFILE}"; then
    echo "OK: All Homebrew packages installed successfully."
    exit 0
  fi
  if [[ ${attempt} -lt ${MAX_ATTEMPTS} ]]; then
    echo "WARN: brew bundle failed on attempt ${attempt}; retrying in ${RETRY_DELAY}s..." >&2
    sleep "${RETRY_DELAY}"
  fi
done

echo "ERROR: brew bundle failed after ${MAX_ATTEMPTS} attempts." >&2
echo "       Inspect the journal:  journalctl --user -u brew-bundle.service" >&2
exit 1
