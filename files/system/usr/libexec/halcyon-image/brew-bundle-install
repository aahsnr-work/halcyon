#!/usr/bin/env bash
# halcyon brew bundle installer (runs once at first login via brew-bundle.service)
#
# Design:
#  - brew-setup.service (system, root, basic.target) extracts the tarball to
#    /home/linuxbrew/.linuxbrew BEFORE any user session starts.
#  - This script therefore expects brew to already be present; if it is not,
#    it waits briefly in case of an unusually slow first boot.
#  - brew bundle is retried up to 3 times with linear back-off for transient
#    network failures at session start-up.
set -euo pipefail

readonly BREW="/home/linuxbrew/.linuxbrew/bin/brew"
readonly BREWFILE="/usr/share/ublue-os/homebrew/Brewfile"

echo "=== Halcyon: brew-bundle one-shot installation ==="

# --- Sanity: Brewfile must be present (shipped in the image) ---
if [[ ! -f "${BREWFILE}" ]]; then
  echo "ERROR: ${BREWFILE} not found in the image — cannot install packages." >&2
  exit 1
fi

# --- Wait for brew binary (brew-setup.service runs before user sessions, but
#     on an extremely slow first boot it may still be extracting the tarball) ---
if [[ ! -x "${BREW}" ]]; then
  echo "INFO: Homebrew binary not yet present; waiting for brew-setup.service to finish (up to 60s)..."
  waited=0
  while [[ ! -x "${BREW}" && ${waited} -lt 60 ]]; do
    sleep 2
    waited=$((waited + 2))
  done
fi

if [[ ! -x "${BREW}" ]]; then
  echo "ERROR: ${BREW} not found or not executable after 60s — brew-setup.service may have failed." >&2
  echo "       Run:  systemctl status brew-setup.service" >&2
  exit 1
fi

# --- Suppress brew telemetry and noise ---
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_ENV_HINTS=1

# --- Run brew bundle with linear-backoff retries for transient network issues ---
readonly MAX_ATTEMPTS=3
readonly RETRY_DELAY=15  # seconds between retries

for attempt in $(seq 1 "${MAX_ATTEMPTS}"); do
  echo "INFO: brew bundle --no-lock --file=${BREWFILE}  (attempt ${attempt}/${MAX_ATTEMPTS})"
  if "${BREW}" bundle --no-lock --file="${BREWFILE}"; then
    echo "OK: All Homebrew packages installed successfully."
    exit 0
  fi
  if [[ ${attempt} -lt ${MAX_ATTEMPTS} ]]; then
    echo "WARN: brew bundle failed on attempt ${attempt}; retrying in ${RETRY_DELAY}s..." >&2
    sleep "${RETRY_DELAY}"
  fi
done

echo "ERROR: brew bundle failed after ${MAX_ATTEMPTS} attempts." >&2
echo "       Inspect the journal:  journalctl --user -u brew-bundle.service" >&2
exit 1
