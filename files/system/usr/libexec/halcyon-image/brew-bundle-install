#!/usr/bin/env bash
# halcyon brew bundle installer (runs once at first login)
set -euo pipefail

BREW="/home/linuxbrew/.linuxbrew/bin/brew"
BREWFILE="/usr/share/ublue-os/homebrew/Brewfile"

echo "=== Halcyon Homebrew Bundle Initialization ==="

# 1. Wait for Homebrew binary to be available (in case brew-setup.service is extracting)
if [[ ! -x "${BREW}" ]]; then
  echo "Homebrew binary not yet found; waiting for brew-setup.service..."
  timeout=120
  while [[ ! -x "${BREW}" && ${timeout} -gt 0 ]]; do
    sleep 2
    timeout=$((timeout - 2))
  done
fi

if [[ ! -x "${BREW}" ]]; then
  echo "ERROR: ${BREW} not found or not executable after 120s timeout." >&2
  exit 1
fi

if [[ ! -f "${BREWFILE}" ]]; then
  echo "ERROR: ${BREWFILE} not found." >&2
  exit 1
fi

export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_ENV_HINTS=1

# 2. Run brew bundle with automatic retry on transient failure (e.g. initial network bringup)
max_attempts=5
attempt=1
delay=5

while [[ ${attempt} -le ${max_attempts} ]]; do
  echo "Executing: brew bundle --no-lock --file=${BREWFILE} (attempt ${attempt}/${max_attempts})"
  if "${BREW}" bundle --no-lock --file="${BREWFILE}"; then
    echo "Brew bundle installation succeeded!"
    exit 0
  fi
  echo "WARN: brew bundle failed on attempt ${attempt}. Retrying in ${delay}s..." >&2
  sleep "${delay}"
  attempt=$((attempt + 1))
  delay=$((delay * 2))
done

echo "ERROR: Failed to install brew bundle packages after ${max_attempts} attempts." >&2
exit 1
