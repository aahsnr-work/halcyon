#!/usr/bin/env bash

# Required packages: grim, slurp, swappy, niri, jq

set -uo pipefail

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTION]

Options:
    -r, --region        Capture region (default)
    -f, --fullscreen    Capture fullscreen
    -w, --window        Capture window
    -h, --help          Show help
EOF
    exit 0
}

check_wayland() {
    if [[ -z "${WAYLAND_DISPLAY:-}" && (-z "${XDG_SESSION_TYPE:-}" || "${XDG_SESSION_TYPE}" != "wayland") ]]; then
        echo "Warning: Not in Wayland session" >&2
        read -r -p "Continue? [y/N] " -n 1 -r REPLY
        echo
        [[ "$REPLY" =~ ^[Yy]$ ]] || exit 0
    fi
}

capture_region() {
    check_wayland

    selection=$(slurp 2>&1) || {
        [[ $? -eq 1 ]] && exit 0
        echo "Error: slurp failed" >&2
        exit 1
    }
    [[ -z "$selection" ]] && exit 1
    grim -g "$selection" - | swappy -f -
}

capture_fullscreen() {
    check_wayland
    grim - | swappy -f -
}

capture_window() {
    check_wayland

    # Use niri's pick-window to get window information
    window_info=$(niri msg --json pick-window 2>&1) || {
        echo "Error: Failed to pick window" >&2
        exit 1
    }

    # Extract geometry from niri output
    geometry=$(echo "$window_info" | jq -r '.rect | "\(.x),\(.y) \(.width)x\(.height)"')
    [[ -z "$geometry" || "$geometry" == "null" ]] && {
        echo "Error: No window selected or invalid geometry" >&2
        exit 1
    }

    grim -g "$geometry" - | swappy -f -
}

# Default to region capture if no arguments
[[ $# -eq 0 ]] && {
    capture_region
    exit 0
}

case "$1" in
-r | --region) capture_region ;;
-f | --fullscreen) capture_fullscreen ;;
-w | --window) capture_window ;;
-h | --help) usage ;;
*)
    echo "Error: Unknown option '$1'" >&2
    exit 1
    ;;
esac
