#!/usr/bin/env bash
set -euo pipefail

# Safe Removal Tool - Moves files to XDG Trash instead of deleting them
# Follows the XDG Trash Specification for compatibility with desktop environments

readonly SCRIPT_NAME="$(basename "$0")"
readonly VERSION="2.0.0"

# XDG Trash directory (uppercase Trash per XDG spec)
readonly TRASH_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/Trash/files"
readonly TRASH_INFO_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/Trash/info"

# Default flags
FORCE_MODE=false
VERBOSE_MODE=false

# Colors for output
readonly COLOR_RED='\033[0;31m'
readonly COLOR_GREEN='\033[0;32m'
readonly COLOR_YELLOW='\033[0;33m'
readonly COLOR_RESET='\033[0m'

# Show help information
show_help() {
    cat << EOF
${SCRIPT_NAME} - Safe Removal Tool (Version ${VERSION})

DESCRIPTION:
    A safer alternative to 'rm' that moves files and directories to the XDG
    Trash directory instead of permanently deleting them. Files can be restored
    using your desktop environment's trash manager or manually from:
    ${TRASH_DIR}

USAGE:
    ${SCRIPT_NAME} [OPTIONS] <file1> [file2 ...]

ARGUMENTS:
    <file1> [file2 ...]    One or more files or directories to move to trash

OPTIONS:
    -f, --force           Skip confirmation prompt (non-interactive mode)
    -v, --verbose         Show detailed output of operations
    -h, --help            Display this help message and exit
    --version             Show version information and exit

DEPENDENCIES:
    - bash (version 4.0 or higher)
    - GNU coreutils (mv, realpath)
    - Standard Unix utilities (mkdir, basename, date)

EXAMPLES:
    # Interactive mode (default) - prompts for confirmation
    ${SCRIPT_NAME} file.txt document.pdf

    # Force mode - no confirmation prompt
    ${SCRIPT_NAME} -f unwanted_file.log

    # Verbose mode - shows where files are moved
    ${SCRIPT_NAME} -v old_project/

    # Combined flags
    ${SCRIPT_NAME} -fv *.tmp

    # Trash multiple items at once
    ${SCRIPT_NAME} file1.txt file2.txt directory/

NOTES:
    - The script follows the XDG Trash Specification
    - Files are moved to: ${TRASH_DIR}
    - If a file with the same name exists, numbered backups are created
      (e.g., file.txt, file.txt.~1~, file.txt.~2~)
    - The trash directory itself cannot be trashed
    - Non-existent files are skipped with a warning

SEE ALSO:
    rm(1), mv(1), trash-cli, XDG Base Directory Specification

EOF
}

# Show version information
show_version() {
    echo "${SCRIPT_NAME} version ${VERSION}"
}

# Print colored message
print_message() {
    local color="$1"
    local message="$2"
    echo -e "${color}${message}${COLOR_RESET}"
}

# Print verbose message
verbose() {
    if [[ "$VERBOSE_MODE" == true ]]; then
        echo "$@"
    fi
}

# Parse command line arguments
parse_arguments() {
    local args=()
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            --version)
                show_version
                exit 0
                ;;
            -f|--force)
                FORCE_MODE=true
                shift
                ;;
            -v|--verbose)
                VERBOSE_MODE=true
                shift
                ;;
            -*)
                print_message "$COLOR_RED" "Error: Unknown option: $1"
                echo "Try '${SCRIPT_NAME} --help' for more information."
                exit 1
                ;;
            *)
                args+=("$1")
                shift
                ;;
        esac
    done
    
    # Return remaining arguments
    printf '%s\n' "${args[@]}"
}

# Main function
main() {
    # Parse arguments
    local -a remaining_args
    mapfile -t remaining_args < <(parse_arguments "$@")
    
    # Check if any files were provided
    if [[ ${#remaining_args[@]} -eq 0 ]]; then
        print_message "$COLOR_RED" "Error: No files or directories specified"
        echo "Usage: ${SCRIPT_NAME} [OPTIONS] <file1> [file2 ...]"
        echo "Try '${SCRIPT_NAME} --help' for more information."
        exit 1
    fi
    
    # Create trash directories if they don't exist
    mkdir -p "$TRASH_DIR" "$TRASH_INFO_DIR"
    verbose "Trash directory: $TRASH_DIR"
    
    # Get real paths for trash directory
    local trash_realpath
    trash_realpath="$(realpath "$TRASH_DIR")"
    
    # Validate targets and build list
    local -a valid_targets=()
    local -a target_basenames=()
    
    for item in "${remaining_args[@]}"; do
        # Check if item exists
        if [[ ! -e "$item" ]]; then
            print_message "$COLOR_YELLOW" "Warning: '$item' does not exist, skipping"
            continue
        fi
        
        # Prevent trashing the trash directory itself
        local item_realpath
        item_realpath="$(realpath "$item")"
        
        if [[ "$item_realpath" == "$trash_realpath" ]]; then
            print_message "$COLOR_YELLOW" "Warning: Cannot trash the trash directory itself, skipping"
            continue
        fi
        
        valid_targets+=("$item")
        target_basenames+=("$(basename "$item")")
    done
    
    # Check if we have any valid targets
    if [[ ${#valid_targets[@]} -eq 0 ]]; then
        print_message "$COLOR_YELLOW" "No valid items to trash"
        exit 0
    fi
    
    # Show what will be trashed
    echo "Moving to trash:"
    printf "  - %s\n" "${target_basenames[@]}"
    
    # Confirm action unless in force mode
    if [[ "$FORCE_MODE" == false ]]; then
        read -r -p "Continue? [y/N]: " REPLY
        if [[ ! "$REPLY" =~ ^[Yy]$ ]]; then
            print_message "$COLOR_YELLOW" "Operation cancelled"
            exit 0
        fi
    fi
    
    # Move items to trash with numbered backups for collisions
    local move_count=0
    for item in "${valid_targets[@]}"; do
        local item_basename
        item_basename="$(basename "$item")"
        local destination="$TRASH_DIR/$item_basename"
        
        if [[ "$VERBOSE_MODE" == true ]]; then
            # Use mv with verbose output and numbered backups
            if mv --backup=numbered -v "$item" "$destination"; then
                ((move_count++)) || true
            else
                print_message "$COLOR_RED" "Error: Failed to move '$item'"
            fi
        else
            # Use mv with numbered backups (quiet mode)
            if mv --backup=numbered "$item" "$destination" 2>/dev/null; then
                ((move_count++)) || true
            else
                print_message "$COLOR_RED" "Error: Failed to move '$item'"
            fi
        fi
    done
    
    # Show completion message
    if [[ $move_count -gt 0 ]]; then
        print_message "$COLOR_GREEN" "✓ Successfully moved $move_count item(s) to trash"
    else
        print_message "$COLOR_RED" "✗ Failed to move any items"
        exit 1
    fi
}

# Run main function with all arguments
main "$@"