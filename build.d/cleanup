#!/usr/bin/env bash
# halcyon — end-of-RUN cleanup (bazzite /ctx/cleanup pattern). Called after
# every image-mutating RUN so temp files, package-manager logs and /boot
# contents never ship in the image layers.
set -eou pipefail
rm -rf /tmp/* /tmp/.[!.]* /tmp/..?* || true
rm -f /var/log/dnf5.log /var/log/dnf5.log.* || true
rm -rf /boot/* /boot/.[!.]* /boot/..?* || true
# drop dnf5's per-repo cached metadata dirs too (the dnf cache is a tmpfs
# cache mount during builds, but be thorough)
rm -rf /var/cache/libdnf5/* || true
